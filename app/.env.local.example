# Solana network: devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoint — use Helius or QuickNode in production for better rate limits
# Get a free key at https://www.helius.dev
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Your deployed YieldPilot program ID (from `anchor deploy` output)
NEXT_PUBLIC_PROGRAM_ID=YPiLt1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZ12

# Comma-separated vault public keys to display
# Create vaults with the initialize_vault instruction first
NEXT_PUBLIC_VAULT_ADDRESSES=
