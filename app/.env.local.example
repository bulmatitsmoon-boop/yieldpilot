# Solana network: devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoint — use Helius or QuickNode in production for better rate limits
# Get a free key at https://www.helius.dev
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Your deployed YieldPilot program ID (from `anchor deploy` output)
NEXT_PUBLIC_PROGRAM_ID=8c7Boyk91MWkn5jabf5CnYD8DrG6p4hYm9eDdAAWXEKH

# Comma-separated vault public keys to display
# Create vaults with the initialize_vault instruction first
# USDC vault: F1r513ZZdofz4tjhRfhNAYDK5hsmc8uCZbMmg2tkPJ6e
# SOL vault:  8KcoRt5DcCbXBaqDVDorEbW2J6GofTrRyy9Afzb8wwaE
NEXT_PUBLIC_VAULT_ADDRESSES=F1r513ZZdofz4tjhRfhNAYDK5hsmc8uCZbMmg2tkPJ6e,8KcoRt5DcCbXBaqDVDorEbW2J6GofTrRyy9Afzb8wwaE

# ─────────────────────────────────────────────────────────────────────────────
# MAINNET values (uncomment these and comment out the devnet block above when
# ready to cut the frontend over to mainnet — this is a deliberate one-time
# switch, not automatic; also swap the IDL import in useYieldPilot.ts to
# idl/yieldpilot.mainnet.json when you do this):
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
