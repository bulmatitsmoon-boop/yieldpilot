{
  "name": "yieldpilot",
  "version": "1.0.0",
  "description": "YieldPilot — automated yield optimizer on Solana",
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "deploy:devnet": "CLUSTER=devnet ts-node scripts/deploy.ts --cluster devnet",
    "deploy:mainnet": "CLUSTER=mainnet-beta ts-node scripts/deploy.ts --cluster mainnet-beta",
    "keeper:dev": "cd keeper && npm run dev",
    "app:dev": "cd app && npm run dev"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.91.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
