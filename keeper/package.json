{
  "name": "yieldpilot-keeper",
  "version": "0.1.0",
  "description": "YieldPilot keeper bot — polls APYs, rebalances, compounds",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "ts-node-dev --respawn src/index.ts",
    "init-vault": "ts-node src/scripts/init-vault.ts",
    "verify:lp-rebalancer": "node scripts/verify-lp-rebalancer.mjs",
    "init-orca-lp-vault": "ts-node src/scripts/init-orca-lp-vault.ts",
    "init-raydium-lp-vault": "ts-node src/scripts/init-raydium-lp-vault.ts",
    "postinstall": "node ../scripts/patch-bigint-buffer.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.91.1",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@solana/web3.js": "^1.91.1",
    "uuid": "^11.1.1"
  }
}
