# Solana RPC endpoint (use a paid RPC like Helius or QuickNode in production)
RPC_URL=https://api.devnet.solana.com

# Path to your keeper wallet keypair JSON
# This wallet pays transaction fees — fund it with ~0.1 SOL
KEEPER_KEYPAIR_PATH=~/.config/solana/id.json

# Your deployed YieldPilot program ID
PROGRAM_ID=YPiLt1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZ12

# Vault public keys to monitor (comma-separated)
VAULT_ADDRESSES=VAULT_PUBKEY_1,VAULT_PUBKEY_2

# Path to the IDL file, relative to this directory (defaults to idl/yieldpilot.json
# if unset). Point this at idl/yieldpilot.mainnet.json when running against mainnet.
IDL_PATH=idl/yieldpilot.json

# Rebalance threshold: trigger if any protocol drifts this many bps from target
# e.g. 500 = rebalance when allocation drifts >5%
REBALANCE_THRESHOLD_BPS=500

# Minimum APY improvement to trigger rebalance (in bps)
# e.g. 100 = only rebalance if new allocation gains >1% APY
MIN_APY_IMPROVEMENT_BPS=100

# How often to poll APYs (cron expression)
APY_POLL_CRON=*/15 * * * *

# How often to attempt compound (cron expression — program enforces 1hr minimum)
COMPOUND_CRON=0 * * * *

# Kamino API base URL
KAMINO_API_URL=https://api.kamino.finance

# Marinade API base URL
MARINADE_API_URL=https://api.marinade.finance

# Log level: error | warn | info | debug
LOG_LEVEL=info

# Optional: Telegram alerts channel (compound + rebalance events only, not a
# general chat channel). Both unset = feature no-ops cleanly, safe to deploy
# without either configured. Create the bot via @BotFather, add it as an
# admin on your channel, then find the channel ID via
# https://api.telegram.org/bot<TOKEN>/getUpdates after posting once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERTS_CHANNEL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# MAINNET values (uncomment when pointing the keeper at mainnet):
# ─────────────────────────────────────────────────────────────────────────────
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# PROGRAM_ID=BvBALz1Rv5Si4ypc1jn84NndN17wkMJa74A4T5ksyQCx
# VAULT_ADDRESSES=AborKLCjKvPzdXLBshAtbRbdnsGfmk5joXUxFFEZKMi1,EZBEWAm75JsX3MwnB1fbutx7EiyFgkhZUhLTdJ9Nxkc
# IDL_PATH=idl/yieldpilot.mainnet.json
